# Copied to ~/.config/thoughtdag/env (mode 600) by deploy/install.sh.
# Provider keys are NOT here: server.mjs reads the checkout's own .env
# (shell variables win over it), so keep keys in /home/ala/x/thoughtdag/.env.
PORT=9122
HOST=127.0.0.1
SERVE_DIST=/home/ala/x/thoughtdag/dist
NODE_ENV=production
# The server runs as the user whose Claude Code login answers `claude -p`.
# The picker's own "Claude plan" door is blocked on a non-loopback hostname,
# so the plan's models are registered here instead.
CLAUDE_CODE_MODELS=opus,sonnet
